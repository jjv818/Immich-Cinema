<?xml version="1.0" encoding="utf-8"?>
<!-- Bare icon controls: transparent by default, thin white hairline on focus (no pill fill). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent_clear" />
            <stroke android:width="2dp" android:color="@color/media_control_hairline" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/media_control_pressed" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent_clear" />
        </shape>
    </item>
</selector>
