<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Only styles that are actually referenced remain. The legacy Leanback sample
      card/playback/error kit (MovieCard*, SquareBigCard*, SingleLineCard*, IconCard*,
      GridCardTheme, TimelineCardTheme, DefaultCardTheme, VideoCardViewTheme, MediaListHeader*,
      ErrorUi*, Body/Title, QRTitle, MyPopupMenu) was removed with its last consumers.
    -->

    <style name="ProgressBar" parent="AppTheme">
        <item name="colorAccent">@color/progressbarColor</item>
    </style>

    <!-- ===== Settings surface (SET-001..SET-005) ===== -->
    <!--
      Preference theme for the redesigned settings surface. Derives from the Leanback
      preference overlay and re-points row text/widget/paddings at the design tokens.
      Declared on AppTheme via `preferenceTheme`; scoping is fragment-local because the
      preference views are inflated inside a ContextThemeWrapper keyed on this attr.
    -->
    <style name="SettingsPreferenceTheme" parent="PreferenceThemeOverlay.v14.Leanback">
        <!-- The preference surface's background stack (artwork + settings_backdrop_scrim)
             lives in the pane host (settings_screen_pane). Clear the windowBackground so
             leanback_preference_fragment's `?android:attr/windowBackground` root does not
             paint over the artwork; the list-pref screens hosted in the pane inherit the
             same transparency. -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="defaultBrandColor">@android:color/transparent</item>
        <!-- Screen heading (decor title). -->
        <item name="android:titleTextStyle">@style/SettingsScreenTitle</item>
        <item name="android:titleTextAppearance">@style/TextAppearance.SettingsScreenTitle</item>
        <!-- Row title / summary follow the Body/Meta type scale. -->
        <item name="android:textAppearanceListItem">@style/TextAppearance.SettingsRowTitle</item>
        <item name="android:textAppearanceListItemSecondary">@style/TextAppearance.SettingsRowSummary</item>
        <item name="android:textAppearanceListItemSmall">@style/TextAppearance.SettingsSectionHeader</item>
        <!-- Row insets: spacing scale (24dp horizontal). -->
        <item name="android:listPreferredItemPaddingStart">@dimen/space_3</item>
        <item name="android:listPreferredItemPaddingEnd">@dimen/space_3</item>
        <!-- Selection indicators only: seekbar progress, radio dots in list dialogs. -->
        <item name="colorAccent">@color/accent_brand</item>
        <item name="colorControlActivated">@color/accent_brand</item>
        <!-- Grouped iOS-style rows on raised chips, toggle switches for booleans,
             chevron widget is applied per-row for drill-ins. -->
        <item name="preferenceStyle">@style/SettingsPreferenceRow</item>
        <item name="preferenceCategoryStyle">@style/SettingsPreferenceCategory</item>
        <item name="checkBoxPreferenceStyle">@style/SettingsPreferenceSwitch</item>
        <!-- Switch rows: the schema's booleans are CheckBoxPreference (above), but any
             SwitchPreferenceCompat/SwitchPreference must render the same chip + real
             SwitchCompat widget. -->
        <item name="switchPreferenceCompatStyle">@style/SettingsPreferenceSwitch</item>
        <item name="switchPreferenceStyle">@style/SettingsPreferenceSwitch</item>
        <!-- ListPreference / MultiSelectListPreference (and EditTextPreference) resolve
             dialogPreferenceStyle — chip row + trailing chevron. -->
        <item name="dialogPreferenceStyle">@style/SettingsPreferenceDialogRow</item>
        <item name="editTextPreferenceStyle">@style/SettingsPreferenceDialogRow</item>
        <item name="preferenceScreenStyle">@style/SettingsPreferenceRow</item>
        <item name="seekBarPreferenceStyle">@style/SettingsPreferenceSeekbar</item>
        <item name="preferenceFragmentListStyle">@style/SettingsPreferenceList</item>
    </style>

    <style name="SettingsScreenTitle">
        <item name="android:minHeight">@dimen/settings_row_min_height</item>
        <item name="android:layout_marginTop">@dimen/overscan_vertical</item>
        <item name="android:layout_marginStart">?android:attr/listPreferredItemPaddingStart</item>
        <item name="android:layout_marginEnd">?android:attr/listPreferredItemPaddingEnd</item>
        <item name="android:textAppearance">@style/TextAppearance.SettingsScreenTitle</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="SettingsPreferenceRow" parent="@style/LeanbackPreference"
        tools:ignore="PrivateResource">
        <item name="android:layout">@layout/settings_preference_row</item>
    </style>

    <!-- ListPreference / MultiSelectListPreference / EditTextPreference resolve
         dialogPreferenceStyle (NOT preferenceStyle) — without this they fall back to the
         flat Leanback default row and break the chip treatment on every nested screen
         (e.g. the Ordering screen). Chevron widget: these all open a picker/dialog. -->
    <style name="SettingsPreferenceDialogRow" parent="@style/LeanbackPreference.DialogPreference"
        tools:ignore="PrivateResource">
        <item name="android:layout">@layout/settings_preference_row</item>
        <item name="android:widgetLayout">@layout/settings_widget_chevron</item>
    </style>

    <style name="SettingsPreferenceCategory" parent="@style/LeanbackPreference.Category">
        <item name="android:layout">@layout/settings_preference_category</item>
    </style>

    <style name="SettingsPreferenceSwitch" parent="@style/LeanbackPreference.CheckBoxPreference">
        <item name="android:layout">@layout/settings_preference_row</item>
        <item name="android:widgetLayout">@layout/settings_widget_switch</item>
    </style>

    <style name="SettingsPreferenceSeekbar" parent="@style/LeanbackPreference.SeekBarPreference">
        <item name="android:layout">@layout/settings_preference_widget_seekbar</item>
    </style>

    <style name="SettingsPreferenceList" parent="@style/PreferenceFragmentList.Leanback">
        <item name="android:paddingBottom">@dimen/space_4</item>
    </style>

    <style name="TextAppearance.SettingsScreenTitle" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.SettingsRowTitle" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.SettingsRowSummary" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/text_meta</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.SettingsSectionHeader" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_meta</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Dialog shell for the floating settings panel: transparent window over the artwork,
         dimmed via backgroundDimAmount (SET-004). -->
    <style name="SettingsDialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">@dimen/settings_window_dim</item>
    </style>

    <!-- ===== Guided step (sign-in; AUTH-001) =====
         Descendants of the stock Leanback styles, re-pointed at the §5.1 tokens. Every style
         here is wired through a theme attribute on GuidedStepTheme (see themes.xml) - no
         app-level lb_* resource overrides, so the change cannot leak into other Leanback
         surfaces. Text colours are constant per role; focus feedback is the white hairline
         selector (never colour-only), matching the settings-row reference treatment. -->
    <style name="GuidedStep.GuidanceContainer" parent="Widget.Leanback.GuidanceContainerStyle">
        <!-- Safe gutter (48dp) instead of the stock 56dp start padding so the guidance block
             aligns with every other surface's overscan margin. -->
        <item name="android:paddingStart">@dimen/overscan_horizontal</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
    </style>

    <style name="GuidedStep.GuidanceTitle" parent="Widget.Leanback.GuidanceTitleStyle">
        <!-- Heading 30sp / text_primary; stock was 36sp sans-serif-light. -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="GuidedStep.GuidanceDescription" parent="Widget.Leanback.GuidanceDescriptionStyle">
        <!-- Body 20sp / text_secondary; stock was 14sp / #88F1F1F1 (~53% white). -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="GuidedStep.GuidanceBreadcrumb" parent="Widget.Leanback.GuidanceBreadcrumbStyle">
        <!-- Carries the build version above the product name (Meta 18sp / text_secondary).
             Stock is 18sp condensed at 53% white; only the family and colour change. -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="GuidedStep.GuidanceIcon" parent="Widget.Leanback.GuidanceIconStyle">
        <!-- Own brand mark at 100dp instead of the stock 140dp, with the margin on the 16dp
             spacing step: frees ~44dp for the Heading-30sp title so it fits on one line. -->
        <item name="android:layout_width">@dimen/guided_step_icon_size</item>
        <item name="android:layout_marginEnd">@dimen/space_2</item>
    </style>

    <style name="GuidedStep.ButtonActionsList" parent="Widget.Leanback.GuidedButtonActionsListStyle">
        <!-- 8dp a side instead of 24dp: a Body-20sp button label needs ~90dp of text width and
             the stock 0.45-weight column only offers ~73dp. -->
        <item name="android:paddingStart">@dimen/space_1</item>
        <item name="android:paddingEnd">@dimen/space_1</item>
    </style>

    <style name="GuidedStep.ActionItemContainer" parent="Widget.Leanback.GuidedActionItemContainerStyle">
        <!-- Raised chip behind every action row (see guided_action_chip.xml): seamless on the
             raised main-action panel, individual chips on the page-coloured button column.
             Padding: 8dp vertical / 16dp horizontal on the spacing scale (stock was 14/13/16/16).
             The vertical step is deliberately the tighter one: at 16sp a step-2 list of four rows
             reached the 48dp bottom safe gutter, and a TV overscan margin is not negotiable. -->
        <item name="android:paddingTop">@dimen/space_1</item>
        <item name="android:paddingBottom">@dimen/space_1</item>
        <item name="android:paddingStart">@dimen/space_2</item>
        <item name="android:paddingEnd">@dimen/space_2</item>
        <item name="android:background">@drawable/guided_action_chip</item>
    </style>

    <style name="GuidedStep.ActionItemTitle" parent="Widget.Leanback.GuidedActionItemTitleStyle">
        <!-- Body 20sp / text_primary; stock was 14sp sans-serif-condensed. Constant colour:
             the hairline selector carries focus (same contract as settings rows). -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="GuidedStep.ActionItemDescription" parent="Widget.Leanback.GuidedActionItemDescriptionStyle">
        <!-- Meta 18sp / text_secondary; stock was 12sp sans-serif-condensed at 50% alpha
             (unusable at 10 feet). Full alpha - hierarchy comes from the colour, not a
             focus-dependent fade. -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_meta</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:alpha">1.0</item>
    </style>

    <style name="GuidedStep.ActionItemCheckmark" parent="Widget.Leanback.GuidedActionItemCheckmarkStyle">
        <!-- 10-foot legibility: 24dp glyph (same value the settings chevron uses) for the
             SSL / debug checkboxes, up from the stock 16dp. -->
        <item name="android:layout_width">@dimen/settings_chevron_size</item>
        <item name="android:layout_height">@dimen/settings_chevron_size</item>
    </style>

</resources>
