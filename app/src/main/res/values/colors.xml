<resources>
    <!-- Warm dark gray for backgrounds -->
    <color name="gray_dark">#212121</color>

    <color name="black">#000000</color>

    <!-- Colors defined dedicated for TV screen white. -->
    <color name="screen_white">#E8EAED</color>
    <color name="screen_white_70">#B2E8EAED</color>
    <color name="screen_white_60">#99E8EAED</color>
    <color name="screen_white_10">#1AE8EAED</color>

    <!-- Colors defined dedicated for TV screen black. -->
    <color name="screen_black">#0E0E0F</color>

    <color name="default_text_color">@color/screen_white</color>
    <color name="default_text_color_secondary">@color/screen_white_60</color>

    <color name="default_card_background_color">#263238</color>
    <color name="default_card_footer_background_color">#37474F</color>
    <color name="selected_card_footer_background_color">#F0F</color>

    <color name="action_button_ripple_color">@color/black</color>
    <color name="action_button_background_focused_color">@color/screen_white</color>
    <color name="action_button_background_unfocused_color">@color/screen_white_10</color>
    <color name="action_button_text_focused_color">@color/screen_black</color>
    <color name="action_button_text_unfocused_color">@color/screen_white_70</color>

    <color name="error_text">#EF9A9A</color>

    <color name="settings_card_background">#0277BD</color>
    <color name="settings_card_background_focussed">#01579B</color>

    <color name="progressbarColor">#ffffff</color>

    <!-- Immich-like timeline scrubber accent -->
    <color name="timeline_scrubber_accent">#4250AF</color>
    <color name="timeline_scrubber_label">@color/screen_white</color>
    <color name="timeline_scrubber_dot">@color/screen_white_70</color>

    <!-- ===== Immich Cinema design system (AGENTS.md §5.1) ===== -->
    <color name="surface_base">#0A0A0B</color>
    <color name="surface_raised">#141416</color>
    <color name="text_primary">#F2F2F7</color>
    <color name="text_secondary">#99FFFFFF</color>
    <color name="text_tertiary">#61FFFFFF</color>
    <color name="focus_hairline">#D9FFFFFF</color>
    <!-- Soft white glow behind the focus hairline (tv-focus-navigation-kit recipe: 8dp spread @ ~28%). -->
    <color name="focus_glow">#47FFFFFF</color>
    <color name="accent_brand">#4250AF</color>
    <color name="tab_scrim">#99000000</color>
    <!-- Tab bar labels: active pill label is near-black (surface_base), idle labels stay near-white. -->
    <color name="tab_text_active">#0A0A0B</color>
    <color name="tab_text_idle">#E6FFFFFF</color>
    <!-- Timeline scrubber focus badge fill (Immich dark bg-subtle/90). -->
    <color name="scrubber_badge">#E62A2A2A</color>
    <!-- Scrim gradient endpoints (top -> bottom). -->
    <color name="scrim_bottom_start">#00000000</color>
    <color name="scrim_bottom_end">#B3000000</color>
    <color name="scrim_top_start">#73000000</color>
    <color name="scrim_top_end">#00000000</color>
    <!-- Card placeholder surface (shown only while artwork loads). -->
    <color name="card_placeholder">#1A1A1A</color>
    <!-- Legacy playback/popup chrome (kept as named tokens pending a deeper viewer pass). -->
    <color name="playback_header">#282248</color>
    <color name="playback_item_regular">#FF6255</color>
    <color name="playback_item_favorite">#FF6E40</color>
    <color name="popup_background">#0F213F</color>

</resources>