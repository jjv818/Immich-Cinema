<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timeline_mosaic_cell"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/timeline_mosaic_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Single monochrome play/pause glyph, bottom-right (AGENTS.md §5.3). No duration text. -->
    <LinearLayout
        android:id="@+id/timeline_mosaic_video_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/video_badge_margin"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/timeline_mosaic_video_play_pause"
            android:layout_width="@dimen/video_badge_size"
            android:layout_height="@dimen/video_badge_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_video_badge_play" />
    </LinearLayout>
</FrameLayout>
