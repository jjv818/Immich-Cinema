<?xml version="1.0" encoding="utf-8"?>
<!--
  iOS-style settings row: surface_raised chip, text-first (title Body 20sp + summary
  Meta 15sp from the preference theme), trailing widget_frame for the toggle switch or a
  chevron for drill-in rows. No icon tile. Focus renders via settings_row_background
  (focus_hairline + glow); the row as a whole is the single focusable/clickable target.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/settings_row_min_height"
    android:layout_marginTop="@dimen/space_1"
    android:background="@drawable/settings_row_background"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:maxLines="2"
            android:textAppearance="?android:attr/textAppearanceListItem" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:maxLines="4"
            android:textAppearance="?android:attr/textAppearanceListItemSecondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent" />

</LinearLayout>
