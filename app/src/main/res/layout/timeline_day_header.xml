<?xml version="1.0" encoding="utf-8"?>
<!-- Day header: left-aligned bold white label, restrained (Body bold, not a screen title). Extra
     bottom padding clears focused mosaic cell scale overflow. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timeline_day_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:paddingTop="@dimen/day_header_padding_vertical"
    android:paddingBottom="@dimen/day_header_padding_vertical"
    android:textColor="@color/text_primary"
    android:textSize="@dimen/text_body"
    android:textStyle="bold" />
