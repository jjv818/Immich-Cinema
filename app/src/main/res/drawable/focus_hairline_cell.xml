<?xml version="1.0" encoding="utf-8"?>
<!-- Mosaic cell focus: same white hairline + soft glow as cards. The corners MUST match the cell's
     own radius (@dimen/radius_cell) — a square outline over a rounded cell reads as four stray
     corner brackets. Replaces the legacy #4250AF accent ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/focus_glow_width"
                android:color="@color/focus_glow" />
            <corners android:radius="@dimen/radius_cell" />
        </shape>
    </item>
    <item android:inset="@dimen/focus_hairline_inset">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/focus_hairline_width"
                android:color="@color/focus_hairline" />
            <corners android:radius="@dimen/radius_cell" />
        </shape>
    </item>
</layer-list>
