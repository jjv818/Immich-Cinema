<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom scrim: transparent at top, black 70% at bottom, for text over photography.
     angle=270 => gradient runs top->bottom (start at top). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/scrim_bottom_start"
        android:endColor="@color/scrim_bottom_end"
        android:type="linear" />
</shape>
